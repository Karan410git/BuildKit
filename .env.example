# Application
APP_NAME=BuildKit
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
JWT_SECRET_KEY=development-only-secret-key-32-bytes-long
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
# POSTGRES_* variables are consumed by Docker Compose to build DATABASE_URL
# for the backend service. Defaults shown below are development-only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgresdev
POSTGRES_DB=buildkit

# For local development without Docker.
# Docker Compose overrides DATABASE_URL internally using the postgres service hostname.
DATABASE_URL=postgresql+psycopg2://postgres:postgresdev@localhost:5432/buildkit