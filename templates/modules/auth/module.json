{
  "schema_version": 1,
  "name": "auth",
  "description": "Generic registration, login, JWT, and profile capability.",
  "selectable": true,
  "requires": ["frontend", "fastapi", "postgres", "migrations", "config"],
  "files": [
    {"source": "files/backend/app/api/routes/auth.py", "destination": "backend/app/api/routes/auth.py"},
    {"source": "files/backend/app/core/security.py", "destination": "backend/app/core/security.py"},
    {"source": "files/backend/app/models/user.py", "destination": "backend/app/models/user.py"},
    {"source": "files/backend/app/schemas/auth.py", "destination": "backend/app/schemas/auth.py"},
    {"source": "files/backend/alembic/versions/20260816_000001_create_users_table.py", "destination": "backend/alembic/versions/20260816_000001_create_users_table.py"},
    {"source": "files/frontend/src/features/auth/api.ts", "destination": "frontend/src/features/auth/api.ts"},
    {"source": "files/frontend/src/features/auth/LoginPage.tsx", "destination": "frontend/src/features/auth/LoginPage.tsx"},
    {"source": "files/frontend/src/features/auth/RegisterPage.tsx", "destination": "frontend/src/features/auth/RegisterPage.tsx"},
